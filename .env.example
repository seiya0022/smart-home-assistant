TZ=Asia/Tokyo
# Use pulse to follow the OS default input/output (GNOME Settings -> Sound).
# For direct ALSA hardware access, use plughw:CARD=...,DEV=0 from scripts/detect-audio.sh.
MIC_DEVICE=pulse
SND_DEVICE=pulse
# Audio ducking: lower other apps while Jarvis is listening/responding (20%)
AUDIO_DUCK_ENABLED=1
DUCK_LEVEL=20%
DUCK_TIMEOUT=40
# Wake word chime (WAV). Place file at this path; omitted from service if missing.
AWAKE_WAV=assets/sounds/awake.wav
MAC_MINI_IP=192.168.1.100
OLLAMA_MODEL=qwen2.5:3b
