[Unit]
Description=Wyoming Satellite (ThinkPad host)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=simple
Environment=XDG_RUNTIME_DIR=/run/user/@@USER_ID@@
EnvironmentFile=@@REPO_ROOT@@/.env
# Future: --awake-wav @@REPO_ROOT@@/assets/awake.wav
ExecStart=@@WYOMING_DIR@@/script/run \
  --name 'ThinkPad' \
  --uri 'tcp://0.0.0.0:10700' \
  --mic-command 'arecord -D @@MIC_DEVICE@@ -r 16000 -c 1 -f S16_LE -t raw' \
  --snd-command 'aplay -D @@SND_DEVICE@@ -r 22050 -c 1 -f S16_LE -t raw' \
  --wake-uri 'tcp://127.0.0.1:10400' \
  --wake-word-name 'hey_jarvis' \
  --vad \
  --vad-threshold=0.6 \
  --wake-refractory-seconds=8 \
  --detection-command '@@REPO_ROOT@@/scripts/audio-duck.sh start' \
  --tts-played-command '@@REPO_ROOT@@/scripts/audio-duck.sh stop' \
  --error-command '@@REPO_ROOT@@/scripts/audio-duck.sh stop'
WorkingDirectory=@@WYOMING_DIR@@
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
